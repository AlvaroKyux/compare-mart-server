# Copia este archivo a ".env" y ajusta los valores según tu entorno local
# o el que te dé el proveedor de hosting (Render, Railway, etc.).

PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=compare_mart_dev

# Alternativa: si el proveedor de hosting da una sola URL de conexión
# (Render/Railway suelen hacerlo), descomenta y usa esta en vez de las 5 de arriba:
# DATABASE_URL=postgres://usuario:password@host:puerto/nombre_bd
